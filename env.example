# ─────────────────────────────────────────────────────────────
# SevaSetu Backend Environment Configuration (template)
# The setup scripts copy this file to `.env` automatically.
#   scripts/setup.ps1  (Windows)   scripts/setup.sh  (macOS/Linux)
# Or manually:  cp env.example .env   /   Copy-Item env.example .env
# The backend (backend/database.py) reads these via python-dotenv.
# ─────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────
# Supabase PostgreSQL connection string.
# Use the "Connection pooling" (port 6543) URI from Supabase → Project Settings → Database.
# backend/database.py auto-normalizes postgres:// → postgresql://
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# For a fully local quick start without Postgres, SQLite also works:
# DATABASE_URL=sqlite:///./sevasetu_local.db

# ── Supabase (optional — for future client-side features) ───
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
# APP_ENV=production requires ADMIN_SECRET_KEY for /api/v1/system/* endpoints
ADMIN_SECRET_KEY=

# ── Gemini AI Triage (optional — falls back to pure rule-based triage) ──
GEMINI_API_KEY=

# ── BHASHINI Translation (optional — offline clinical dictionary fallback) ──
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── ABDM Sandbox (optional mock adapters work without these) ──
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway

# ── eSanjeevani Teleconsult (Jitsi domain) ──
ESANJEEVANI_JITSI_DOMAIN=meet.jit.si

# ── OTP delivery via Meta WhatsApp Cloud API (optional) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=sevasetu_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v20.0
